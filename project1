class DoctorCard extends StatefulWidget {
  final String name, department, imageUrl;
  const DoctorCard({super.key, required this.name, required this.department, required this.imageUrl});
  @override
  State<DoctorCard> createState() => _DoctorCardState();
}

class _DoctorCardState extends State<DoctorCard> {
  int rating = 0;

  @override
  Widget build(BuildContext context) => Card(
    margin: const EdgeInsets.only(bottom: 15),
    child: Padding(
      padding: const EdgeInsets.all(12),
      child: Column(children: [
        Row(children: [
          ClipRRect(borderRadius: BorderRadius.circular(40),
            child: Image.network(widget.imageUrl, width: 75, height: 75, fit: BoxFit.cover,
              errorBuilder: (_, __, ___) => const CircleAvatar(radius: 37, child: Icon(Icons.person)))),
          const SizedBox(width: 15),
          Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Text(widget.name, style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 17)),
            const SizedBox(height: 5),
            Text(widget.department, style: const TextStyle(color: Colors.blue)),
          ])),
        ]),
        const Divider(height: 25),
        const Align(alignment: Alignment.centerLeft,
            child: Text('Rate this doctor', style: TextStyle(fontWeight: FontWeight.bold))),
        Row(children: List.generate(5, (i) => IconButton(
          onPressed: () => setState(() => rating = i + 1),
          icon: Icon(i < rating ? Icons.star : Icons.star_border, color: Colors.amber, size: 30),
        ))),
        Text(rating == 0 ? 'No rating given' : 'Your rating: $rating/5'),
      ]),
    ),
  );
}

